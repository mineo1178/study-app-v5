rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/families/$(familyId)).data.memberUids is list
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow update: if isFamilyMember(familyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeStudyTaskId'])
        && (request.resource.data.activeStudyTaskId == null || request.resource.data.activeStudyTaskId is string);
      allow create, delete: if false;

      match /tasks/{taskId} {
        allow read, create, update, delete: if isFamilyMember(familyId);
      }
      match /tests/{testId} {
        allow read, create, update, delete: if isFamilyMember(familyId);
      }
      match /reviewUsers/{uid} {
        function ownReview() { return isFamilyMember(familyId) && request.auth.uid == uid; }
        function reviewId(v) { return v is string && v.matches('^[A-Za-z0-9_-]{1,100}$'); }
        function reviewText(v, max) { return v is string && v.size() > 0 && v.size() <= max && !v.matches('\\s*'); }
        function reviewChoice(v) { return reviewText(v, 300) && !v.matches('\\s[\\s\\S]*') && !v.matches('[\\s\\S]*\\s'); }
        function subject(v) { return v in ['math', 'japanese', 'science', 'social']; }
        function testKind(v) { return v in ['未指定', '判定', '組分け', 'カリテ', 'その他']; }
        function questionShape(q, id) {
          return q.keys().hasOnly(['id', 'version', 'subject', 'unit', 'prompt', 'choices', 'correctIndex', 'explanation', 'testKind', 'source'])
            && q.id == id && reviewId(id) && reviewId(q.version) && subject(q.subject)
            && reviewText(q.unit, 100) && reviewText(q.prompt, 1000) && reviewText(q.explanation, 1000)
            && q.choices is list && q.choices.size() == 4
            && reviewChoice(q.choices[0]) && reviewChoice(q.choices[1]) && reviewChoice(q.choices[2]) && reviewChoice(q.choices[3])
            && q.choices.toSet().size() == 4 && q.correctIndex is int && q.correctIndex >= 0 && q.correctIndex <= 3
            && testKind(q.testKind) && q.source is string && q.source.size() <= 300;
        }
        match /questions/{questionId} {
          allow read: if ownReview();
          allow create: if ownReview() && questionShape(request.resource.data, questionId);
          allow update: if ownReview() && questionShape(request.resource.data, questionId) && request.resource.data.version != resource.data.version;
          allow delete: if false;
        }
        match /weaknesses/{weaknessId} {
          function ids(v) {
            return v is list && v.size() <= 5 && v.toSet().size() == v.size()
              && (v.size() < 1 || reviewId(v[0])) && (v.size() < 2 || reviewId(v[1]))
              && (v.size() < 3 || reviewId(v[2])) && (v.size() < 4 || reviewId(v[3])) && (v.size() < 5 || reviewId(v[4]));
          }
          allow read: if ownReview();
          allow create, update: if ownReview()
            && request.resource.data.keys().hasOnly(['id', 'subject', 'unit', 'mistake', 'point', 'testKind', 'questionIds'])
            && request.resource.data.id == weaknessId && reviewId(weaknessId) && subject(request.resource.data.subject)
            && reviewText(request.resource.data.unit, 100) && reviewText(request.resource.data.mistake, 1000)
            && reviewText(request.resource.data.point, 1000) && testKind(request.resource.data.testKind) && ids(request.resource.data.questionIds);
          allow delete: if false;
        }
        function progressPath(qid) { return /databases/$(database)/documents/families/$(familyId)/reviewUsers/$(uid)/progress/$(qid); }
        function attemptPath(id) { return /databases/$(database)/documents/families/$(familyId)/reviewUsers/$(uid)/attempts/$(id); }
        match /attempts/{attemptId} {
          function answerShape(a) {
            let q = get(/databases/$(database)/documents/families/$(familyId)/reviewUsers/$(uid)/questions/$(a.questionId)).data;
            return a.keys().hasOnly(['id', 'uid', 'sessionId', 'questionId', 'questionVersion', 'selectedIndex', 'correct', 'answeredAt', 'elapsedMs', 'mode', 'prompt', 'selected', 'expected', 'explanation'])
              && a.id == attemptId && reviewId(a.sessionId) && attemptId.matches('^' + a.sessionId + '_[0-4]$')
              && a.uid == uid && reviewId(a.questionId) && a.questionVersion == q.version
              && a.selectedIndex is int && a.selectedIndex >= 0 && a.selectedIndex <= 3
              && a.correct == (a.selectedIndex == q.correctIndex) && a.prompt == q.prompt
              && a.selected == q.choices[a.selectedIndex] && a.expected == q.choices[q.correctIndex] && a.explanation == q.explanation
              && a.mode in ['daily', 'retry'] && a.answeredAt is int && a.answeredAt >= 0 && a.answeredAt <= request.time.toMillis()
              && a.elapsedMs is int && a.elapsedMs >= 0 && a.elapsedMs <= a.answeredAt;
          }
          function paired(a) {
            let p = progressPath(a.questionId);
            return getAfter(p).data.recordedAttemptId == attemptId
              && getAfter(p).data.count == (exists(p) ? get(p).data.count + 1 : 1);
          }
          allow read: if ownReview();
          allow create: if ownReview() && answerShape(request.resource.data) && paired(request.resource.data);
          allow update, delete: if false;
        }
        match /progress/{questionId} {
          function pairedProgress(p, old) {
            let a = getAfter(attemptPath(p.recordedAttemptId)).data;
            let newer = old == null || a.answeredAt >= old.latestAt;
            let sameVersion = old != null && old.questionVersion == a.questionVersion;
            return !exists(attemptPath(p.recordedAttemptId)) && a.questionId == questionId
              && p == {
                'questionId': questionId,
                'questionVersion': newer ? a.questionVersion : old.questionVersion,
                'count': old == null ? 1 : old.count + 1,
                'firstCorrect': old == null ? a.correct : old.firstCorrect,
                'previousCorrect': newer ? (sameVersion ? old.latestCorrect : a.correct) : old.previousCorrect,
                'latestCorrect': newer ? a.correct : old.latestCorrect,
                'latestAt': newer ? a.answeredAt : old.latestAt,
                'nextAt': newer ? a.answeredAt + (a.correct ? (a.mode == 'retry' ? 86400000 : 259200000) : 0) : old.nextAt,
                'latestAttemptId': newer ? a.id : old.latestAttemptId,
                'recordedAttemptId': a.id,
                'latestMode': newer ? a.mode : old.latestMode
              };
          }
          allow read: if ownReview();
          allow create: if ownReview() && pairedProgress(request.resource.data, null);
          allow update: if ownReview() && pairedProgress(request.resource.data, resource.data);
          allow delete: if false;
        }
      }
      match /dailyCalculations/{uid}/days/{dateKey} {
        function ownCalculation() {
          return isFamilyMember(familyId) && request.auth.uid == uid;
        }
        function score(value) { return value is int && value >= 0 && value <= 7; }
        function seconds(value) { return value is int && value >= 0 && value <= 14400; }
        function dayShape(data) {
          return data.keys().hasOnly(['dateKey', 'attemptCount', 'firstScore', 'firstElapsedSeconds', 'latestScore', 'latestElapsedSeconds', 'bestScore', 'latestAttemptId'])
            && data.dateKey == dateKey && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.attemptCount is int && data.attemptCount > 0
            && score(data.firstScore) && score(data.latestScore) && score(data.bestScore)
            && seconds(data.firstElapsedSeconds) && seconds(data.latestElapsedSeconds)
            && data.latestAttemptId is string;
        }
        function latestMatches(data) {
          let attempt = getAfter(/databases/$(database)/documents/families/$(familyId)/dailyCalculations/$(uid)/days/$(dateKey)/attempts/$(data.latestAttemptId)).data;
          return attempt.attemptNo == data.attemptCount && attempt.dateKey == dateKey
            && attempt.score == data.latestScore && attempt.elapsedSeconds == data.latestElapsedSeconds;
        }
        allow read: if isFamilyMember(familyId);
        allow create: if ownCalculation() && dayShape(request.resource.data) && latestMatches(request.resource.data)
          && request.resource.data.attemptCount == 1
          && request.resource.data.firstScore == request.resource.data.latestScore
          && request.resource.data.bestScore == request.resource.data.latestScore
          && request.resource.data.firstElapsedSeconds == request.resource.data.latestElapsedSeconds;
        allow update: if ownCalculation() && dayShape(request.resource.data) && latestMatches(request.resource.data)
          && request.resource.data.attemptCount == resource.data.attemptCount + 1
          && request.resource.data.firstScore == resource.data.firstScore
          && request.resource.data.firstElapsedSeconds == resource.data.firstElapsedSeconds
          && request.resource.data.bestScore == (resource.data.bestScore > request.resource.data.latestScore ? resource.data.bestScore : request.resource.data.latestScore);
        allow delete: if false;
        match /attempts/{attemptId} {
          function validAttempt(data) {
            return data.keys().hasOnly(['id', 'dateKey', 'score', 'elapsedSeconds', 'startedAt', 'finishedAt', 'attemptNo', 'maxScore', 'attemptType', 'createdAt', 'taskId', 'taskLabel'])
              && (!('taskId' in data) || (data.taskId is string && data.taskId.size() > 0 && data.taskId.size() <= 200
                && get(/databases/$(database)/documents/families/$(familyId)/tasks/$(data.taskId)).data.subject == 'math'
                && get(/databases/$(database)/documents/families/$(familyId)/tasks/$(data.taskId)).data.category == '計算'))
              && (!('taskLabel' in data) || ('taskId' in data && data.taskLabel is string && data.taskLabel.size() > 0 && data.taskLabel.size() <= 300))
              && data.id == attemptId && data.dateKey == dateKey && data.dateKey is string
              && score(data.score) && seconds(data.elapsedSeconds) && data.maxScore == 7
              && data.attemptNo is int && data.attemptNo > 0
              && data.attemptType == (data.attemptNo == 1 ? 'first' : 'redo')
              && data.startedAt is number && data.startedAt >= 0 && data.finishedAt is number && data.finishedAt >= data.startedAt
              && data.createdAt is number && data.createdAt >= 0;
          }
          function sequenceMatches(data) {
            let day = /databases/$(database)/documents/families/$(familyId)/dailyCalculations/$(uid)/days/$(dateKey);
            return data.attemptNo == (exists(day) ? get(day).data.attemptCount + 1 : 1)
              && getAfter(day).data.attemptCount == data.attemptNo
              && getAfter(day).data.latestAttemptId == attemptId;
          }
          allow read: if isFamilyMember(familyId);
          allow create: if ownCalculation() && validAttempt(request.resource.data) && sequenceMatches(request.resource.data);
          allow update, delete: if false;
        }
      }
      match /rewardLedger/{rewardKey} {
        allow read, create: if isFamilyMember(familyId);
      }
      match /game/idol-produce {
        allow read, create, update: if isFamilyMember(familyId);

        match /weeks/{weekId} {
          allow read, create: if isFamilyMember(familyId);
        }
        match /performances/{performanceId} {
          allow read, create: if isFamilyMember(familyId);
        }
        match /rivalBattles/{battleId} {
          allow read, create: if isFamilyMember(familyId);
        }
        match /gacha/state {
          allow read, create, update: if isFamilyMember(familyId);
        }
        match /gachaWeeks/{weekId} {
          allow read, create: if isFamilyMember(familyId);
        }
        match /gachaDraws/{drawId} {
          allow read, create: if isFamilyMember(familyId);
        }
        match /gachaExchanges/{exchangeId} {
          allow read, create: if isFamilyMember(familyId);
        }
      }
    }
  }
}
